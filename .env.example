# ---------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------
# Base das chamadas do axios. Em produção deixe "/api" (mesma origem).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# Backend (Route Handlers em src/app/api + src/server)
# ---------------------------------------------------------------
# Datas do dashboard/agendamentos assumem o servidor em UTC (como o Adonis)
TZ=UTC
# Desenvolvimento: Postgres local. `docker compose up` sobe o banco e aplica as migrations. Não roda o seed.
# Produção: as mesmas chaves em .env.production (Supabase). `npm start` aplica as migrations nesse banco antes do Next.
DATABASE_URL=postgresql://lincepet:lincepet@127.0.0.1:5433/lincepet
DIRECT_URL=postgresql://lincepet:lincepet@127.0.0.1:5433/lincepet
# Só para `npm run db:migrar-mysql`: banco MySQL antigo (origem da cópia de dados).
MYSQL_ORIGEM_URL=mysql://<USUARIO>:<SENHA>@<HOST>:3306/<BANCO>
# Mesmo APP_KEY do Adonis: mantém válidos os tokens e senhas já emitidos
APP_KEY=
FRONTEND_BASE_URL=http://localhost:3000

# E-mail (logo opcional: EMAIL_LOGO_URL ou EMAIL_LOGO_BASE64)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_LOGO_URL=

# Storage de imagens (Supabase Storage). Só no servidor: nunca use prefixo NEXT_PUBLIC.
# SUPABASE_SERVICE_ROLE_KEY aceita a service_role (legada) ou a nova secret key (sb_secret_...).
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lincepet-media
# Laudos de exame (PDF): bucket privado, baixado só por URL assinada.
SUPABASE_LAUDOS_BUCKET=lincepet-laudos
# Só dev/e2e: guarda laudos em disco em vez do Supabase (proibido em produção).
# LAUDOS_STORAGE_DIR=test-results/laudos
# LAUDOS_STORAGE_SECRET=

# Asaas
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_API_KEY_SANDBOX=
ASAAS_API_KEY_PROD=
ASAAS_BASE_URL=
ASAAS_BASE_URL_SANDBOX=
ASAAS_BASE_URL_PROD=
# Obrigatório com ASAAS_ENV=production (32 a 255 caracteres, igual ao authToken do webhook no Asaas)
ASAAS_WEBHOOK_TOKEN=

# Google (login social e Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:3000/api/google/calendar/callback

# Notificações do navegador (Web Push). Gere o par com `npx web-push generate-vapid-keys`.
# Sem as chaves o push fica desligado e o resto do site funciona normalmente.
# O par abaixo é só de TESTE (público no repositório): nunca use em produção.
# Trocar o par invalida as inscrições: cada aparelho precisa religar o interruptor.
VAPID_PUBLIC_KEY=BGIhB__hexRna_yh7vTrFC2BBhvxIBSQu9mNSqnL72z8edShA3wZck9hn94bKoOjwGYoaohCfer-pa-2yods_e4
VAPID_PRIVATE_KEY=SY0hpTwvboXl0yiUNGl0Wz-L-jZOInCIxfx2_ZVY5D4
VAPID_SUBJECT=mailto:contato@lincepet.com.br

# WhatsApp (número central, provedor agnóstico). Sem provedor real, use "log" (só registra no console).
# "gateway" envia pelo serviço lince-pet-whatsapp-gateway (repositório e Render próprios).
WHATSAPP_PROVIDER=log
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=

# Segredo da rota /api/cron/lembretes-whatsapp (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
