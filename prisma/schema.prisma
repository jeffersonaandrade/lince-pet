// =============================================================================
// Schema Prisma derivado das migrations do backend AdonisJS 6 (Lucid ORM)
// (Lince-Pet-Backend-main/database/migrations, aplicadas em ordem natural).
//
// - NÃO houve acesso ao banco: antes de ir para produção, validar este arquivo
//   com `npx prisma db pull --print` contra o banco MySQL real e comparar.
// - Durante a transição, as migrations continuam sendo responsabilidade do
//   Adonis. NÃO rodar `prisma migrate` / `prisma db push` neste banco.
// - Colunas boolean (tinyint(1)) estão mapeadas como Int de propósito: o mysql2
//   devolve 0/1 e o frontend depende desses valores numéricos.
// - Nomes de campos = nomes das propriedades dos models Lucid (@map p/ coluna).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @db.Char(36)
  email                    String    @unique @db.VarChar(255)
  password                 String    @db.VarChar(255)
  /// ENUM('tutor','veterinario','clinica')
  userType                 String    @map("user_type")
  nome                     String    @db.VarChar(255)
  celular                  String?   @db.VarChar(15)
  cep                      String?   @db.VarChar(8)
  rua                      String?   @db.VarChar(255)
  cidade                   String?   @db.VarChar(100)
  estado                   String?   @db.VarChar(2)
  ativo                    Int?      @default(1) @db.TinyInt
  isEmailVerified          Int?      @default(0) @map("is_email_verified") @db.TinyInt
  profilePic               String?   @map("profile_pic") @db.VarChar(500)
  createdAt                DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt                DateTime? @map("updated_at") @db.Timestamp(0)
  sobrenome                String?   @db.VarChar(100)
  numero                   String?   @db.VarChar(10)
  bairro                   String?   @db.VarChar(100)
  googleAccessToken        String?   @map("google_access_token") @db.Text
  googleRefreshToken       String?   @map("google_refresh_token") @db.Text
  googleTokenExpiresAt     DateTime? @map("google_token_expires_at") @db.Timestamp(0)
  googleCalendarAuthorized Int?      @default(0) @map("google_calendar_authorized") @db.TinyInt

  // TODO(verify): no Lucid são hasOne, mas user_id não tem UNIQUE nas migrations, então o Prisma exige lista.
  tutor               Tutor[]
  veterinario         Veterinario[]
  clinica             Clinica[]
  payments            Payment[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]

  @@index([userType])
  @@index([email])
  @@index([cep])
  @@index([cidade])
  @@index([ativo])
  @@map("users")
}

model Tutor {
  id        String    @id @db.Char(36)
  userId    String?   @map("user_id") @db.Char(36)
  cpf       String?   @unique @db.VarChar(14)
  /// ENUM('masculino','feminino','outro')
  genero    String?
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]
  pets         Pet[]
  favorites    Favorite[]
  payments     Payment[]
  avaliacoes   Avaliacao[]

  @@map("tutores")
}

model Veterinario {
  id                         String    @id @db.Char(36)
  userId                     String?   @map("user_id") @db.Char(36)
  cpf                        String?   @db.VarChar(14)
  cnpj                       String?   @db.VarChar(18)
  /// ENUM('masculino','feminino','outro')
  genero                     String?
  crmv                       String?   @unique @db.VarChar(15)
  bio                        String?   @db.Text
  fotoUrl                    String?   @map("foto_url") @db.VarChar(1024)
  atendePresencial           Int?      @default(0) @map("atende_presencial") @db.TinyInt
  atendeOnline               Int?      @default(0) @map("atende_online") @db.TinyInt
  atendeDomicilio            Int?      @default(0) @map("atende_domicilio") @db.TinyInt
  precoConsulta              Decimal?  @map("preco_consulta") @db.Decimal(10, 2)
  onboardingComplete         Int?      @default(0) @map("onboarding_complete") @db.TinyInt
  onboardingStep             Int?      @default(1) @map("onboarding_step")
  isVerified                 Int?      @default(0) @map("is_verified") @db.TinyInt
  createdAt                  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt                  DateTime? @map("updated_at") @db.Timestamp(0)
  creditos                   Int       @default(0)
  precoConsultaOnline        Decimal?  @map("preco_consulta_online") @db.Decimal(10, 2)
  horariosOnline             Json?     @map("horarios_online")
  subscriptionPlanCode       String?   @default("pro") @map("subscription_plan_code") @db.VarChar(50)
  monthlyAppointmentsUsed    Int?      @default(0) @map("monthly_appointments_used")
  monthlyAppointmentsResetAt DateTime? @map("monthly_appointments_reset_at") @db.Timestamp(0)

  user                User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enderecos           VeterinarioEndereco[]
  agendamentos        Agendamento[]
  avaliacoes          Avaliacao[]
  favorites           Favorite[]
  experiencias        ExperienciaVeterinario[]
  // TODO(verify): Lucid declara belongsTo `subscription`, mas não existe coluna subscription_id em veterinarios; relação omitida (usar a lista abaixo).
  subscriptions       Subscription[]
  payments            Payment[]
  creditsLedger       CreditsLedger[]
  veterinarioPlanos   VeterinarioPlano[]
  veterinarioClinicas VeterinarioClinica[]
  bloqueiosAgenda     BloqueioAgenda[]

  @@map("veterinarios")
}

model Clinica {
  id                    String    @id @db.Char(36)
  userId                String?   @map("user_id") @db.Char(36)
  cnpj                  String?   @unique @db.VarChar(18)
  descricao             String?   @db.Text
  horariosFuncionamento Json?     @map("horarios_funcionamento")
  // TODO(verify): alterado de integer default 0 para string(10) via .alter(); MODIFY do MySQL deve ter removido o default.
  quantidadeVets        String?   @map("quantidade_vets") @db.VarChar(10)
  onboardingComplete    Int?      @default(0) @map("onboarding_complete") @db.TinyInt
  isVerified            Int?      @default(0) @map("is_verified") @db.TinyInt
  createdAt             DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime? @map("updated_at") @db.Timestamp(0)
  nomeClinica           String?   @map("nome_clinica") @db.VarChar(200)
  /// ENUM('solo','multipla')
  tipoClinica           String?   @default("solo") @map("tipo_clinica")
  nomeFantasia          String?   @map("nome_fantasia") @db.VarChar(255)
  razaoSocial           String?   @map("razao_social") @db.VarChar(255)
  endereco              String?   @db.VarChar(255)
  cep                   String?   @db.VarChar(10)
  cidade                String?   @db.VarChar(255)
  estado                String?   @db.VarChar(2)
  latitude              String?   @db.VarChar(255)
  longitude             String?   @db.VarChar(255)
  telefone              String?   @db.VarChar(255)
  whatsapp              String?   @db.VarChar(255)
  horarioFuncionamento  Json?     @map("horario_funcionamento")
  comodidades           Json?
  fotoPerfil            String?   @map("foto_perfil") @db.VarChar(255)
  fotoCapa              String?   @map("foto_capa") @db.VarChar(255)
  sobre                 String?   @db.Text
  subscriptionPlanCode  String?   @default("free") @map("subscription_plan_code") @db.VarChar(255)

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites            Favorite[]
  avaliacoes           Avaliacao[]
  agendamentos         Agendamento[]
  veterinarioEnderecos VeterinarioEndereco[]
  subscriptions        Subscription[]
  veterinarioClinicas  VeterinarioClinica[]
  clinicaDiferenciais  ClinicaDiferencial[]
  clinicaPlanos        ClinicaPlano[]

  @@map("clinicas")
}

model Especialidade {
  id        String    @id @db.Char(36)
  nome      String    @unique @db.VarChar(255)
  descricao String?   @db.Text
  ativo     Int?      @default(1) @db.TinyInt
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  relacionamentos EspecialidadeRelacionamento[]

  @@map("especialidades")
}

model VeterinarioClinica {
  veterinarioId String    @map("veterinario_id") @db.Char(36)
  clinicaId     String    @map("clinica_id") @db.Char(36)
  ativo         Int?      @default(1) @db.TinyInt
  status        String?   @default("pendente") @db.VarChar(255)
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  veterinario Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  clinica     Clinica     @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@id([veterinarioId, clinicaId])
  @@index([veterinarioId])
  @@index([clinicaId])
  @@index([ativo])
  @@map("veterinario_clinicas")
}

/// Antiga veterinario_especialidades (renomeada). Pivot polimórfica: entidade_tipo = 'veterinario' | 'clinica'.
model EspecialidadeRelacionamento {
  // TODO(verify): polimórfica (vet ou clínica); FK p/ veterinarios removida, sem FK. Índices herdaram nomes veterinario_especialidades_*.
  entidadeId      String    @map("entidade_id") @db.Char(36)
  especialidadeId String    @map("especialidade_id") @db.Char(36)
  ativo           Int?      @default(1) @db.TinyInt
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)
  entidadeTipo    String    @default("veterinario") @map("entidade_tipo") @db.VarChar(20)

  especialidade Especialidade @relation(fields: [especialidadeId], references: [id], onDelete: Cascade)

  @@id([entidadeId, especialidadeId, entidadeTipo])
  @@index([entidadeId])
  @@index([especialidadeId])
  @@index([ativo])
  @@map("especialidade_relacionamentos")
}

model Diferencial {
  id        String    @id @db.Char(36)
  nome      String    @unique @db.VarChar(255)
  icone     String?   @db.VarChar(255)
  descricao String?   @db.Text
  ativo     Int?      @default(1) @db.TinyInt
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  clinicaDiferenciais ClinicaDiferencial[]

  @@map("diferenciais")
}

model ClinicaDiferencial {
  clinicaId     String    @map("clinica_id") @db.Char(36)
  diferencialId String    @map("diferencial_id") @db.Char(36)
  ativo         Int?      @default(1) @db.TinyInt
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  clinica     Clinica     @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  diferencial Diferencial @relation(fields: [diferencialId], references: [id], onDelete: Cascade)

  @@id([clinicaId, diferencialId])
  @@index([clinicaId])
  @@index([diferencialId])
  @@index([ativo])
  @@map("clinica_diferenciais")
}

model ExperienciaVeterinario {
  id            String    @id @db.Char(36)
  veterinarioId String    @map("veterinario_id") @db.Char(36)
  local         String    @db.VarChar(255)
  cargo         String    @db.VarChar(255)
  dataInicio    DateTime? @map("data_inicio") @db.Date
  dataFim       DateTime? @map("data_fim") @db.Date
  descricao     String?   @db.Text
  ativo         Int?      @default(1) @db.TinyInt
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  veterinario Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)

  @@index([veterinarioId])
  @@index([ativo])
  @@map("experiencias_veterinarios")
}

model VeterinarioEndereco {
  id                            String    @id @db.Char(36)
  veterinarioId                 String    @map("veterinario_id") @db.Char(36)
  rua                           String    @db.VarChar(255)
  numero                        String    @db.VarChar(20)
  bairro                        String?   @db.VarChar(100)
  complemento                   String?   @db.VarChar(100)
  cidade                        String    @db.VarChar(100)
  estado                        String    @db.VarChar(2)
  cep                           String    @db.VarChar(8)
  /// No Lucid, a propriedade `horariosDisponibilidade` aponta para a coluna horarios_funcionamento.
  horariosDisponibilidade       Json?     @map("horarios_funcionamento")
  // TODO(verify): coluna horarios_disponibilidade não tem propriedade no Lucid (nome colide com o campo acima); nomeado como horariosDisponibilidadeColuna.
  horariosDisponibilidadeColuna Json?     @map("horarios_disponibilidade")
  aceitaEmergencia              Int?      @default(0) @map("aceita_emergencia") @db.TinyInt
  observacoes                   String?   @db.Text
  isPrimary                     Int?      @default(0) @map("is_primary") @db.TinyInt
  ativo                         Int?      @default(1) @db.TinyInt
  createdAt                     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt                     DateTime? @map("updated_at") @db.Timestamp(0)
  precoConsulta                 Decimal   @default(0) @map("preco_consulta") @db.Decimal(10, 2)
  nomeClinica                   String?   @map("nome_clinica") @db.VarChar(255)
  fotoUrl                       String?   @map("foto_url") @db.VarChar(255)
  clinicaId                     String?   @map("clinica_id") @db.Char(36)

  veterinario Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  clinica     Clinica?    @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@index([veterinarioId])
  @@index([cidade])
  @@index([estado])
  @@index([ativo])
  @@map("veterinario_enderecos")
}

model Plano {
  id        String    @id @db.Char(36)
  name      String    @db.VarChar(255)
  image     String?   @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  veterinarioPlanos VeterinarioPlano[]
  clinicaPlanos     ClinicaPlano[]

  @@map("planos")
}

model VeterinarioPlano {
  veterinarioId String    @map("veterinario_id") @db.Char(36)
  planoId       String    @map("plano_id") @db.Char(36)
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  veterinario Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  plano       Plano       @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@id([veterinarioId, planoId])
  @@map("veterinario_planos")
}

model ClinicaPlano {
  clinicaId String    @map("clinica_id") @db.Char(36)
  planoId   String    @map("plano_id") @db.Char(36)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  clinica Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  plano   Plano   @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@id([clinicaId, planoId])
  @@map("clinica_planos")
}

/// TODO(verify): criada com guarda hasTable(); se a tabela já existia antes da migration, a estrutura real pode diferir.
model Pet {
  id        String    @id @db.Char(36)
  tutorId   String?   @map("tutor_id") @db.Char(36)
  nome      String    @db.VarChar(255)
  especie   String    @db.VarChar(255)
  raca      String?   @db.VarChar(255)
  idade     Int?      @db.UnsignedInt
  fotoUrl   String?   @map("foto_url") @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  /// ENUM('pequeno','medio','grande')
  porte     String?

  tutor        Tutor?        @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@map("pets")
}

/// TODO(verify): criada com guarda hasTable(); se a tabela já existia antes da migration, a estrutura real pode diferir.
model Agendamento {
  id                 String    @id @db.Char(36)
  tutorId            String?   @map("tutor_id") @db.Char(36)
  petId              String?   @map("pet_id") @db.Char(36)
  veterinarioId      String?   @map("veterinario_id") @db.Char(36)
  // TODO(verify): coluna VARCHAR na migration, mas o Lucid trata como column.date.
  dataConsulta       String?   @map("data_consulta") @db.VarChar(255)
  horarioConsulta    String?   @map("horario_consulta") @db.VarChar(255)
  status             String    @db.VarChar(255)
  tipoConsulta       String?   @map("tipo_consulta") @db.VarChar(255)
  precoConsulta      Decimal?  @map("preco_consulta") @db.Decimal(8, 2)
  observacoes        String?   @db.VarChar(255)
  motivoCancelamento String?   @map("motivo_cancelamento") @db.VarChar(255)
  // TODO(verify): coluna VARCHAR na migration, mas o Lucid trata como column.dateTime.
  confirmadoEm       String?   @map("confirmado_em") @db.VarChar(255)
  // TODO(verify): coluna VARCHAR na migration, mas o Lucid trata como column.dateTime.
  canceladoEm        String?   @map("cancelado_em") @db.VarChar(255)
  createdAt          DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime? @map("updated_at") @db.Timestamp(0)
  startCode          String?   @map("start_code") @db.VarChar(12)
  startCodeExpiresAt DateTime? @map("start_code_expires_at") @db.Timestamp(0)
  startCodeUsedAt    DateTime? @map("start_code_used_at") @db.Timestamp(0)
  startCodeAttempts  Int       @default(0) @map("start_code_attempts")
  startedAt          DateTime? @map("started_at") @db.Timestamp(0)
  endedAt            DateTime? @map("ended_at") @db.Timestamp(0)
  paymentStatus      String    @default("unpaid") @map("payment_status") @db.VarChar(255)
  providerPaymentId  String?   @map("provider_payment_id") @db.VarChar(255)
  localNome          String?   @map("local_nome") @db.VarChar(255)
  localEndereco      String?   @map("local_endereco") @db.VarChar(255)
  clinicaId          String?   @map("clinica_id") @db.Char(36)

  tutor       Tutor?       @relation(fields: [tutorId], references: [id])
  pet         Pet?         @relation(fields: [petId], references: [id], onDelete: SetNull)
  veterinario Veterinario? @relation(fields: [veterinarioId], references: [id])
  clinica     Clinica?     @relation(fields: [clinicaId], references: [id], onDelete: SetNull)
  avaliacao   Avaliacao?
  anotacao    AgendamentoAnotacao?

  @@map("agendamentos")
}

/// Anotação privada do veterinário sobre a consulta. Nunca expor para tutor ou clínica.
model AgendamentoAnotacao {
  id               String    @id @db.Char(36)
  agendamentoId    String    @unique @map("agendamento_id") @db.Char(36)
  veterinarioId    String    @map("veterinario_id") @db.Char(36)
  localAtendimento String?   @map("local_atendimento") @db.VarChar(255)
  /// pago | pendente | isento
  statusPagamento  String?   @map("status_pagamento") @db.VarChar(20)
  /// pix | cartao | dinheiro | plano_pet | outro
  formaPagamento   String?   @map("forma_pagamento") @db.VarChar(30)
  planoNome        String?   @map("plano_nome") @db.VarChar(255)
  observacoes      String?   @db.Text
  createdAt        DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime? @map("updated_at") @db.Timestamp(0)

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([veterinarioId])
  @@map("agendamento_anotacoes")
}

/// Bloqueio da agenda (não altera a grade semanal). `horarios` null = dia inteiro.
/// `recorrente` = 1 repete nos `diasSemana` (0=domingo) a partir de `dataInicio`; `dataFim` null = sem fim.
model BloqueioAgenda {
  id              String    @id @db.Char(36)
  veterinarioId   String    @map("veterinario_id") @db.Char(36)
  dataInicio      String    @map("data_inicio") @db.VarChar(10)
  dataFim         String?   @map("data_fim") @db.VarChar(10)
  recorrente      Int       @default(0) @db.TinyInt
  diasSemana      Json?     @map("dias_semana")
  horarios        Json?
  motivo          String?   @db.VarChar(255)
  criadoPorUserId String?   @map("criado_por_user_id") @db.Char(36)
  clinicaId       String?   @map("clinica_id") @db.Char(36)
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)

  veterinario Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)

  @@index([veterinarioId, dataInicio, dataFim])
  @@map("bloqueios_agenda")
}

/// TODO(verify): criada com guarda hasTable(); se a tabela já existia antes da migration, a estrutura real pode diferir.
model Avaliacao {
  id                String    @id @db.Char(36)
  agendamentoId     String    @unique @map("agendamento_id") @db.Char(36)
  tutorId           String    @map("tutor_id") @db.Char(36)
  veterinarioId     String    @map("veterinario_id") @db.Char(36)
  estrelas          Int
  comentario        String?   @db.Text
  createdAt         DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(0)
  clinicaId         String?   @map("clinica_id") @db.Char(36)
  estrelasClinica   Int?      @map("estrelas_clinica")
  comentarioClinica String?   @map("comentario_clinica") @db.Text

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id])
  tutor       Tutor       @relation(fields: [tutorId], references: [id])
  veterinario Veterinario @relation(fields: [veterinarioId], references: [id])
  clinica     Clinica?    @relation(fields: [clinicaId], references: [id])

  @@index([veterinarioId], map: "idx_avaliacoes_veterinario")
  @@index([tutorId], map: "idx_avaliacoes_tutor")
  @@index([clinicaId], map: "idx_avaliacoes_clinica")
  @@map("avaliacoes")
}

model CreditPlan {
  id            String    @id @db.Char(36)
  name          String    @db.VarChar(255)
  credits       Int
  priceCents    Int       @map("price_cents")
  currency      String    @default("brl") @db.VarChar(255)
  stripePriceId String?   @map("stripe_price_id") @db.VarChar(255)
  active        Int       @default(1) @db.TinyInt
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  @@map("credit_plans")
}

model Payment {
  id                      String    @id @db.Char(36)
  userId                  String?   @map("user_id") @db.Char(36)
  tutorId                 String?   @map("tutor_id") @db.Char(36)
  veterinarioId           String?   @map("veterinario_id") @db.Char(36)
  /// ENUM('credits','appointment')
  type                    String
  provider                String    @default("stripe") @db.VarChar(255)
  checkoutSessionId       String?   @map("checkout_session_id") @db.VarChar(255)
  providerPaymentIntentId String?   @map("provider_payment_intent_id") @db.VarChar(255)
  amountCents             Int       @map("amount_cents")
  currency                String    @default("brl") @db.VarChar(255)
  status                  String    @default("pending") @db.VarChar(255)
  metadata                String?   @db.LongText
  createdAt               DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt               DateTime? @map("updated_at") @db.Timestamp(0)

  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  tutor         Tutor?          @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  veterinario   Veterinario?    @relation(fields: [veterinarioId], references: [id], onDelete: SetNull)
  creditsLedger CreditsLedger[]

  @@map("payments")
}

model CreditsLedger {
  id            String    @id @db.Char(36)
  veterinarioId String    @map("veterinario_id") @db.Char(36)
  paymentId     String?   @map("payment_id") @db.Char(36)
  deltaCredits  Int       @map("delta_credits")
  reason        String    @db.VarChar(255)
  meta          String?   @db.LongText
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)

  veterinario Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("credits_ledger")
}

model WebhookEvent {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  provider    String    @db.VarChar(255)
  eventId     String    @unique @map("event_id") @db.VarChar(255)
  type        String    @db.VarChar(255)
  payload     String    @db.LongText
  processedAt DateTime? @map("processed_at") @db.Timestamp(0)
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)

  @@map("webhook_events")
}

model Favorite {
  // TODO(verify): migration usa defaultTo(this.db.rawQuery('UUID()')); não dá para garantir que o DEFAULT foi criado. O Lucid gera o UUID no app.
  id            String    @id @db.Char(36)
  tutorId       String?   @map("tutor_id") @db.Char(36)
  veterinarioId String?   @map("veterinario_id") @db.Char(36)
  clinicaId     String?   @map("clinica_id") @db.Char(36)
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  tutor       Tutor?       @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  veterinario Veterinario? @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  clinica     Clinica?     @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@unique([tutorId, veterinarioId])
  @@unique([tutorId, clinicaId])
  @@map("favorites")
}

model Notification {
  id         String    @id @db.Char(36)
  userId     String?   @map("user_id") @db.Char(36)
  type       String    @db.VarChar(255)
  title      String    @db.VarChar(255)
  message    String    @db.Text
  isRead     Int?      @default(0) @map("is_read") @db.TinyInt
  actionData Json?     @map("action_data")
  createdAt  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model SubscriptionPlan {
  id                      String    @id @db.Char(36)
  code                    String    @unique @db.VarChar(50)
  name                    String    @db.VarChar(255)
  targetType              String    @default("veterinario") @map("target_type") @db.VarChar(255)
  priceCents              Int       @map("price_cents")
  currency                String?   @default("brl") @db.VarChar(255)
  cycle                   String?   @db.VarChar(255)
  monthlyAppointmentLimit Int?      @map("monthly_appointment_limit")
  features                Json?
  searchPriority          Int?      @default(0) @map("search_priority")
  trialDays               Int?      @default(0) @map("trial_days")
  active                  Int?      @default(1) @db.TinyInt
  createdAt               DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt               DateTime? @map("updated_at") @db.Timestamp(0)

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                  String    @id @db.Char(36)
  veterinarioId       String?   @map("veterinario_id") @db.Char(36)
  clinicaId           String?   @map("clinica_id") @db.Char(36)
  planId              String    @map("plan_id") @db.Char(36)
  asaasSubscriptionId String?   @map("asaas_subscription_id") @db.VarChar(255)
  asaasCustomerId     String?   @map("asaas_customer_id") @db.VarChar(255)
  status              String    @default("active") @db.VarChar(50)
  billingType         String?   @map("billing_type") @db.VarChar(50)
  currentPeriodStart  DateTime? @map("current_period_start") @db.Timestamp(0)
  currentPeriodEnd    DateTime? @map("current_period_end") @db.Timestamp(0)
  trialEnd            DateTime? @map("trial_end") @db.Timestamp(0)
  canceledAt          DateTime? @map("canceled_at") @db.Timestamp(0)
  createdAt           DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime? @map("updated_at") @db.Timestamp(0)

  veterinario Veterinario?     @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  clinica     Clinica?         @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  // TODO(verify): coluna criada como string (VARCHAR(255)) referenciando users.id CHAR(36).
  userId    String?   @map("user_id") @db.VarChar(255)
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(0)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
