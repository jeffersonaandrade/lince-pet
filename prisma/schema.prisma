  userId     String?   @map("user_id") @db.Char(36)
  type       String    @db.VarChar(255)
  title      String    @db.VarChar(255)
  message    String    @db.Text
  isRead     Int?      @default(0) @map("is_read") @db.SmallInt
  actionData Json?     @map("action_data")
  createdAt  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model SubscriptionPlan {
  id                      String    @id @db.Char(36)
  code                    String    @unique @db.VarChar(50)
  name                    String    @db.VarChar(255)
  targetType              String    @default("veterinario") @map("target_type") @db.VarChar(255)
  priceCents              Int       @map("price_cents")
  currency                String?   @default("brl") @db.VarChar(255)
  cycle                   String?   @db.VarChar(255)
  monthlyAppointmentLimit Int?      @map("monthly_appointment_limit")
  features                Json?
  searchPriority          Int?      @default(0) @map("search_priority")
  trialDays               Int?      @default(0) @map("trial_days")
  active                  Int?      @default(1) @db.SmallInt
  maxVeterinarios         Int?      @map("max_veterinarios")
  createdAt               DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt               DateTime? @map("updated_at") @db.Timestamp(0)

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                  String    @id @db.Char(36)
  veterinarioId       String?   @map("veterinario_id") @db.Char(36)
  clinicaId           String?   @map("clinica_id") @db.Char(36)
  prestadorId         String?   @map("prestador_id") @db.Char(36)
  planId              String    @map("plan_id") @db.Char(36)
  asaasSubscriptionId String?   @map("asaas_subscription_id") @db.VarChar(255)
  asaasCustomerId     String?   @map("asaas_customer_id") @db.VarChar(255)
  status              String    @default("active") @db.VarChar(50)
  billingType         String?   @map("billing_type") @db.VarChar(50)
  currentPeriodStart  DateTime? @map("current_period_start") @db.Timestamp(0)
  currentPeriodEnd    DateTime? @map("current_period_end") @db.Timestamp(0)
  trialEnd            DateTime? @map("trial_end") @db.Timestamp(0)
  canceledAt          DateTime? @map("canceled_at") @db.Timestamp(0)
  createdAt           DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime? @map("updated_at") @db.Timestamp(0)

  veterinario Veterinario?     @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  clinica     Clinica?         @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  prestador   Prestador?       @relation(fields: [prestadorId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  cancelamento AsaasCancelamento?

  @@index([prestadorId])
  @@map("subscriptions")
}

/// Outbox de cancelamentos: só conclui após evidência do Asaas ou webhook de encerramento.
model AsaasCancelamento {
  subscriptionId String @id @map("subscription_id") @db.Char(36)
  motivo String @db.VarChar(20)
  tentativas Int @default(0)
  solicitadoEm DateTime @default(now()) @map("solicitado_em") @db.Timestamp(3)
  proximaTentativaEm DateTime @default(now()) @map("proxima_tentativa_em") @db.Timestamp(3)
  bloqueadoAte DateTime? @map("bloqueado_ate") @db.Timestamp(3)
  ultimoErro String? @map("ultimo_erro") @db.VarChar(40)
  concluidoEm DateTime? @map("concluido_em") @db.Timestamp(3)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([concluidoEm, proximaTentativaEm])
  @@map("asaas_cancelamentos")
}

/// JWT encerrado no logout antes de expirar (só o `jti` daquela sessão). Linha vencida pode ser apagada.
model SessaoRevogada {
  jti      String   @id @db.Char(36)
  expiraEm DateTime @map("expira_em") @db.Timestamp(0)

  @@index([expiraEm])
  @@map("sessoes_revogadas")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  // TODO(verify): coluna criada como string (VARCHAR(255)) referenciando users.id CHAR(36).
  userId    String?   @map("user_id") @db.VarChar(255)
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(0)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
