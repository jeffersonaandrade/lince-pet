{
  "name": "lince-pet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "eslint && next build",
    "start": "node scripts/migrate-production.mjs && next start",
    "db:up": "docker compose up -d --build",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:migrar-mysql": "tsx scripts/migrar-dados-mysql.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "db:pull": "prisma db pull && prisma generate",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@adonisjs/hash": "^10.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vinejs/vine": "^3.0.1",
    "axios": "^1.20.0",
    "country-state-city": "^3.2.1",
    "dotenv": "^18.0.9",
    "jose": "^6.2.12",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.542.0",
    "luxon": "^3.7.2",
    "moment": "^2.30.1",
    "next": "16.4.2",
    "prisma": "^7.10.1",
    "react": "19.2.9",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.9",
    "recharts": "^3.7.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
